# PostgreSQL (Render Postgres internal URL in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Public origin used in dashboard links and security checks
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Gmail SMTP (use a Google App Password) or any SMTP service
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Amanda Alves <your-email@gmail.com>"
LEAD_NOTIFICATION_EMAIL="your-email@gmail.com"

# Cloudinary for profile, family, content, and seller-photo uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Initial admin; used only by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"

# Optional privacy-conscious analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
