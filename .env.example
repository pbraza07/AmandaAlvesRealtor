# Optional PostgreSQL. Leave unset for email-only mode.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# DATABASE_MODE="enabled"

# Public origin used in dashboard links and security checks
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Recommended on Render Free: Resend's HTTPS email API
RESEND_API_KEY="re_replace_with_your_key"
RESEND_FROM="Amanda Alves <inquiries@your-verified-domain.com>"

# Optional SMTP fallback for hosts that permit outbound SMTP (Render Free does not)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Amanda Alves <your-email@gmail.com>"
LEAD_NOTIFICATION_EMAIL="your-email@gmail.com"

# Public contact and advertising information (used without PostgreSQL)
SITE_PHONE=""
SITE_EMAIL=""
SITE_INSTAGRAM_URL="https://www.instagram.com/amandaalves.realestate/"
SITE_BROKERAGE_NAME="Agile Group Realty – Justin Noe Group"
SITE_BROKERAGE_CONTACT=""
SITE_LICENSE_NUMBER="SL3461857"
SITE_SERVICE_AREAS="Odessa, Lutz, Land O’ Lakes, Wesley Chapel, Dade City, San Antonio, and Brooksville"

# Optional dashboard uploads (requires PostgreSQL mode)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional dashboard administrator (requires PostgreSQL)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"

# Optional privacy-conscious analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
